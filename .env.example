# GEMINI_API_KEY: Google AI Studio Gemini API Key for Build Web mode (Gemini 3.5 Flash Lite).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NVIDIA_API_KEY: Required for Instant tier (google/diffusiongemma-26b-a4b-it via Nvidia API).
NVIDIA_API_KEY="MY_NVIDIA_API_KEY"

# CHATANYWHERE_API_KEY: Required for ChatAnywhere API proxy (Default and PRO tiers).
CHATANYWHERE_API_KEY="MY_CHATANYWHERE_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"


